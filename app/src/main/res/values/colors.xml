<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mirrors of DwmPalette, for the XML layouts only.

         These must match `ui/theme/DwmTokens.kt`. They are duplicated because an
         XML attribute cannot reference a Kotlin constant, not because there are two
         palettes — and the last time nobody wrote that down, this file sat on an
         abandoned Tesla preset (#292B2E) for two releases while the Compose half of
         the app had moved on, which is how the same launcher ended up with three
         palettes at once.

         Views painted with these get remapped to the live day/night variant by
         Ui.skin(); the values here are the day variant so the layouts look right in
         Android Studio's editor preview too. -->
    <color name="bg">#E4E9EF</color>
    <color name="surface">#F2F5F8</color>
    <color name="raised">#FFFFFF</color>
    <color name="hairline">#B0BAC7</color>
    <color name="accent">#0A6A7C</color>
    <color name="textPrimary">#12151A</color>
    <color name="textDim">#55606E</color>

    <!-- Was #8E8E93, a colour in no palette, which is why Settings' section headers
         stayed mid-grey in every theme: Ui.skin() had no entry for it and so never
         touched them. Kept as an alias of textDim so the existing layouts need no
         edit before Settings is rebuilt. -->
    <color name="accent2">#55606E</color>
</resources>
