<resources>
    <!-- Design-for-Driving wants a 76dp touch target, but that was tuned for a
         phone-sized panel. These are the values BEFORE Scale.kt's interface scale
         (default 0.8) — touch_min still lands at ~58dp effective, comfortably above
         the 48dp minimum, while everything else tightens up on the 13" deck. -->
    <dimen name="touch_min">72dp</dimen>
    <dimen name="gap">14dp</dimen>
    <dimen name="dock_icon">46dp</dimen>
    <dimen name="drawer_icon">46dp</dimen>
    <dimen name="tile_height">88dp</dimen>
</resources>
